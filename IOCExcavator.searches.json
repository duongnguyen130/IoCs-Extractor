{
  // Recommended Splunk searches. Outside wwwroot, so it is never served over
  // HTTP. Read on each Extract, cached on the file's timestamp: edit, save,
  // press Extract. Invalid JSON falls back to the built-ins and says so.
  // Comments and trailing commas are allowed.
  //
  //   name       what the analyst sees on the expander
  //   note       one line under it, saying when to use it
  //   template   the search. MUST contain {terms}; {scope} optional
  //   item       how one indicator is written. Default "{value}", always quoted
  //   separator  what joins items. Default " OR ", use ", " for IN (...)
  //   scope      overrides the page's scope box for this search only
  //   source     "search" (default) for hunt terms, "values" for the raw list
  //   include    "all" (default), "clean" to drop flagged, or "flagged"
  //   maxTerms   cap on indicators. Omit for no cap
  //
  // Keys: ipv4 ipv6 domain url email sha256 sha1 md5 sha512 ssdeep filename
  //       commandline registry mutex tool malware actor cve technique other
  // A key left out keeps its built-in search; [] means no search. Max 12 each.

  "version": 1,

  // Used when the scope box on the page is empty.
  "defaultScope": "index=*",

  // Offered when two or more categories are ticked. Same fields as a category,
  // over the pooled and de-duplicated terms of everything ticked.
  "combined": [
    {
      "name": "Any mention",
      "template": "{scope} ({terms})"
    },
    {
      "name": "Noisy indicators dropped",
      "note": "Skips the shared CDN ranges and the admin tools on every host.",
      "template": "{scope} ({terms})",
      "include": "clean"
    }
  ],

  "searches": {

    "ipv4": [
      {
        "name": "Any mention",
        "note": "Widest net. Start here, then narrow with one of the others.",
        "template": "{scope} ({terms})"
      },
      {
        "name": "Traffic to or from",
        "note": "Firewall, proxy and netflow data with CIM address fields.",
        "template": "{scope} (src_ip IN ({terms}) OR dest_ip IN ({terms}))",
        "separator": ", "
      },
      {
        "name": "Traffic, noisy ranges dropped",
        "note": "Same as above without the shared CDN and cloud addresses.",
        "template": "{scope} (src_ip IN ({terms}) OR dest_ip IN ({terms}))",
        "separator": ", ",
        "include": "clean"
      }
    ],

    "ipv6": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "Traffic to or from",
        "template": "{scope} (src_ip IN ({terms}) OR dest_ip IN ({terms}))",
        "separator": ", "
      }
    ],

    "domain": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "DNS resolution",
        "note": "Sysmon event 22, or any DNS source with a query field.",
        "template": "{scope} query IN ({terms})",
        "separator": ", "
      },
      {
        "name": "Web request",
        "note": "Proxy logs.",
        "template": "{scope} (site IN ({terms}) OR dest IN ({terms}))",
        "separator": ", "
      }
    ],

    "url": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "Proxy request",
        "template": "{scope} url IN ({terms})",
        "separator": ", "
      }
    ],

    "email": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "Sender or recipient",
        "note": "Mail gateway logs.",
        "template": "{scope} (sender IN ({terms}) OR recipient IN ({terms}))",
        "separator": ", "
      }
    ],

    "sha256": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "File hash match",
        "note": "Sysmon event 1 and EDR process data.",
        "template": "{scope} (file_hash IN ({terms}) OR process_hash IN ({terms}))",
        "separator": ", ",
        // A big advisory lists hundreds of hashes; keep the search pasteable.
        "maxTerms": 300
      }
    ],

    "sha1": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "File hash match",
        "template": "{scope} (file_hash IN ({terms}) OR process_hash IN ({terms}))",
        "separator": ", ",
        "maxTerms": 300
      }
    ],

    "md5": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "File hash match",
        "template": "{scope} (file_hash IN ({terms}) OR process_hash IN ({terms}))",
        "separator": ", ",
        "maxTerms": 300
      }
    ],

    "sha512": [
      { "name": "Any mention", "template": "{scope} ({terms})" }
    ],

    "ssdeep": [
      { "name": "Any mention", "template": "{scope} ({terms})" }
    ],

    "filename": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "File written or executed",
        "note": "Sysmon events 1 and 11.",
        "template": "{scope} (file_name IN ({terms}) OR process_name IN ({terms}))",
        "separator": ", "
      }
    ],

    "commandline": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "Process command line",
        "note": "Exact match. Attackers vary arguments, so treat a miss as inconclusive.",
        "template": "{scope} process IN ({terms})",
        "separator": ", "
      }
    ],

    "registry": [
      { "name": "Any mention", "template": "{scope} ({terms})" },
      {
        "name": "Registry write",
        "note": "Sysmon events 12 to 14.",
        "template": "{scope} registry_path IN ({terms})",
        "separator": ", "
      }
    ],

    "mutex": [
      { "name": "Any mention", "template": "{scope} ({terms})" }
    ],

    "tool": [
      {
        "name": "Process names",
        "note": "Searches the executables, not the product name.",
        "template": "{scope} ({terms})"
      },
      {
        "name": "Process execution",
        "template": "{scope} process_name IN ({terms})",
        "separator": ", "
      },
      {
        "name": "Product name as written",
        "note": "For ticket notes, where the product is named rather than the binary.",
        "template": "{scope} ({terms})",
        "source": "values"
      }
    ],

    "malware": [
      { "name": "Any mention", "template": "{scope} ({terms})" }
    ],

    "actor": [
      { "name": "Any mention", "template": "{scope} ({terms})" }
    ],

    // A CVE id rarely appears in a log line. Add an entry if your vulnerability
    // data is in Splunk.
    "cve": [],

    "technique": [
      {
        "name": "Any mention",
        "note": "Useful against detection and alert data, not raw telemetry.",
        "template": "{scope} ({terms})"
      }
    ],

    "other": [
      { "name": "Any mention", "template": "{scope} ({terms})" }
    ]
  }
}
