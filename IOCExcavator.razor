    // ====================================================================
    // address handling
    // ====================================================================

    private readonly record struct Net(IPAddress Address, int Prefix)
    {
        public bool IsV4 => Address.AddressFamily == AddressFamily.InterNetwork;
    }

    private static Net? ParseNet(string value)
    {
        string s = value.Trim();
        int slash = s.IndexOf('/');
        string host = slash >= 0 ? s[..slash] : s;

        if (!IPAddress.TryParse(host, out IPAddress? addr)) { return null; }

        int max = addr.AddressFamily == AddressFamily.InterNetwork ? 32 : 128;
        int prefix = max;

        if (slash >= 0 &&
            (!int.TryParse(s[(slash + 1)..], NumberStyles.Integer,
                           CultureInfo.InvariantCulture, out prefix)
             || prefix < 0 || prefix > max))
        {
            return null;
        }

        return new Net(addr, prefix);
    }

    private static bool InRange(IPAddress addr, string cidr)
    {
        Net? net = ParseNet(cidr);
        if (net is null || net.Value.Address.AddressFamily != addr.AddressFamily)
        {
            return false;
        }

        byte[] a = addr.GetAddressBytes();
        byte[] b = net.Value.Address.GetAddressBytes();
        int bits = net.Value.Prefix;

        for (int i = 0; i < a.Length && bits > 0; i++, bits -= 8)
        {
            int mask = bits >= 8 ? 0xFF : (0xFF << (8 - bits)) & 0xFF;
            if ((a[i] & mask) != (b[i] & mask)) { return false; }
        }

        return true;
    }

    /// <summary>Ranges that are not a routable host, with the reason worth telling an analyst.</summary>
    private static readonly (string Cidr, string Why)[] NonRoutable =
    {
        // IPv4 private
        ("10.0.0.0/8", "Private address, likely victim-internal"),
        ("172.16.0.0/12", "Private address, likely victim-internal"),
        ("192.168.0.0/16", "Private address, likely victim-internal"),
        ("127.0.0.0/8", "Loopback address, not a real destination"),
        ("169.254.0.0/16", "Link-local address, not routable"),
        ("100.64.0.0/10", "Carrier-grade NAT range, not a unique host"),
        ("224.0.0.0/4", "Multicast address, not a unicast destination"),

        // IPv4 reserved and documentation
        ("0.0.0.0/8", "Reserved range, not a real destination"),
        ("192.0.0.0/24", "Reserved range, not a real destination"),
        ("192.0.2.0/24", "Documentation range (RFC 5737), not a real host"),
        ("198.18.0.0/15", "Benchmarking range, not a real host"),
        ("198.51.100.0/24", "Documentation range (RFC 5737), not a real host"),
        ("203.0.113.0/24", "Documentation range (RFC 5737), not a real host"),
        ("240.0.0.0/4", "Reserved range, not a real destination"),

        // Carve-outs inside global unicast; everything outside 2000::/3 is handled below.
        ("2001:db8::/32", "Documentation range (RFC 3849), not a real host"),
        ("3fff::/20", "Documentation range (RFC 9637), not a real host"),
        ("2002::/16", "6to4 transition range, not a directly reachable host"),
        ("2001::/32", "Teredo tunnelling range, not a directly reachable host"),
    };

    /// <summary>The only IPv6 block IANA has assigned as global unicast. Anything outside it is not an internet destination.</summary>
    private const string GlobalUnicastV6 = "2000::/3";

    private static string NonGlobalV6Reason(IPAddress addr)
    {
        if (InRange(addr, "::1/128")) { return "Loopback address, not a real destination"; }
        if (InRange(addr, "::/128")) { return "Unspecified address, not a real destination"; }
        if (InRange(addr, "::ffff:0:0/96")) { return "IPv4-mapped address, check it as IPv4 instead"; }
        if (InRange(addr, "64:ff9b::/96")) { return "NAT64 translation range, not a real host"; }
        if (InRange(addr, "100::/64")) { return "Discard-only range, not a real destination"; }
        if (InRange(addr, "fe80::/10")) { return "Link-local address, not routable"; }
        if (InRange(addr, "fc00::/7")) { return "Unique local address, likely victim-internal"; }
        if (InRange(addr, "ff00::/8")) { return "Multicast address, not a unicast destination"; }

        return "Outside assigned global unicast space, not an internet destination";
    }

    /// <summary>Why an address deserves a caveat, or null. Nothing here drops an indicator.</summary>
    private static string? AddressNote(string value)
    {
        Net? parsed = ParseNet(value);
        if (parsed is null) { return null; }

        IPAddress addr = parsed.Value.Address;

        if (!parsed.Value.IsV4 && !InRange(addr, GlobalUnicastV6))
        {
            return NonGlobalV6Reason(addr);
        }

        foreach ((string cidr, string why) in NonRoutable)
        {
            if (InRange(addr, cidr)) { return why; }
        }

        if (parsed.Value.IsV4)
        {
            foreach ((string cidr, string owner) in SharedInfrastructure)
            {
                if (InRange(addr, cidr))
                {
                    return $"Shared infrastructure ({owner}), expect benign hits";
                }
            }
        }

        return null;
    }

    private static void AddAddress(IocStore store, string? value, string source,
                                   string? context = null)
    {
        if (string.IsNullOrWhiteSpace(value)) { return; }

        Net? parsed = ParseNet(value);
        if (parsed is null)
        {
            store.Add("other", value, source, "Unparseable IP");
            return;
        }

        string? note = AddressNote(value);
        IocItem? item = store.Add(parsed.Value.IsV4 ? "ipv4" : "ipv6", value, source,
                                  note ?? context);

        if (item is not null && note is not null) { item.Flagged = true; }
    }

    private static void AddDomain(IocStore store, string? value, string source,
                                  string? context = null)
    {
        if (string.IsNullOrWhiteSpace(value)) { return; }

        string v = value.ToLowerInvariant().TrimEnd('.');
        string? ctx = v.EndsWith(".onion", StringComparison.Ordinal)
            ? "Tor hidden service, only visible in proxy or DNS logs"
            : context;

        store.Add("domain", v, source, ctx);
    }

    private static void AddCve(IocStore store, string cve, string source)
    {
        string id = cve.ToUpperInvariant();
        string ctx = CveContext.TryGetValue(id, out var info)
            ? $"{info.Product}: {info.Issue}"
            : "See NVD for the affected product";

        IocItem? item = store.Add("cve", id, source, ctx);
        if (item is null) { return; }

        item.Nvd = "https://nvd.nist.gov/vuln/detail/" + id;
        item.Kev = "https://www.cisa.gov/known-exploited-vulnerabilities-catalog?search_api_fulltext=" + id;
    }

    private static void AddSoftware(IocStore store, string? name, string source,
                                    string stixType, IEnumerable<string>? malwareTypes,
                                    IEnumerable<string>? aliases)
    {
        if (string.IsNullOrWhiteSpace(name) || SkipNames.Contains(name.Trim())) { return; }

        string clean = name.Trim();
        var types = (malwareTypes ?? Enumerable.Empty<string>())
            .Select(t => t.ToLowerInvariant()).ToList();

        ToolInfo? tool = LookupTool(clean);

        if (tool is not null && !types.Contains("ransomware"))
        {
            string procs = tool.Processes.Length > 0
                ? string.Join(", ", tool.Processes)
                : "keyword hunt";

            IocItem? item = store.Add("tool", clean, source, $"{tool.Kind} ({procs})");
            if (item is not null) { item.Flagged = tool.Noisy; }
        }
        else if (stixType == "tool")
        {
            IocItem? item = store.Add("tool", clean, source,
                "Tool named in the advisory, process name unverified");
            if (item is not null) { item.Guess = true; }
        }
        else
        {
            string ctx = types.Count > 0
                ? string.Join(", ", types)
                : "Malware family named in the advisory";

            store.Add("malware", clean, source, ctx, aliases);
        }
    }

    private static string MitreUrl(string techniqueId) =>
        "https://attack.mitre.org/techniques/"
        + techniqueId.ToUpperInvariant().Replace(".", "/") + "/";

    // ====================================================================
    // text sweep
    // ====================================================================

    private static string Refang(string text) => text
        .Replace("hxxps", "https", StringComparison.OrdinalIgnoreCase)
        .Replace("hxxp", "http", StringComparison.OrdinalIgnoreCase)
        .Replace("[.]", ".", StringComparison.Ordinal)
        .Replace("(.)", ".", StringComparison.Ordinal)
        .Replace("[dot]", ".", StringComparison.OrdinalIgnoreCase)
        .Replace("[:]", ":", StringComparison.Ordinal)
        .Replace("[@]", "@", StringComparison.Ordinal)
        .Replace("[at]", "@", StringComparison.OrdinalIgnoreCase);

    /// <summary>Regex extraction from free text. Deep also pulls domains, URLs and techniques, too noisy for a description field.</summary>
    private static void TextSweep(IocStore store, string? text, string source, bool deep = false)
    {
        if (string.IsNullOrEmpty(text)) { return; }

        string body = Refang(text);

        foreach (Match m in Ipv4Re.Matches(body))
        {
            if (ParseNet(m.Value) is null) { continue; }
            if (store.Has("ipv4", m.Value) || store.Has("ipv6", m.Value)) { continue; }
            AddAddress(store, m.Value, source, deep ? null : "From description text");
        }

        foreach (Match m in HexRe.Matches(body))
        {
            string cat = m.Value.Length switch
            {
                32 => "md5",
                40 => "sha1",
                64 => "sha256",
                _ => "sha512",
            };

            bool known = deep || store.Has(cat, m.Value);
            store.Add(cat, m.Value, source, known ? null : "From description text");
        }

        foreach (Match m in CveRe.Matches(body)) { AddCve(store, m.Value, source); }
        foreach (Match m in EmailRe.Matches(body)) { store.Add("email", m.Value, source); }

        if (!deep) { return; }

        foreach (Match m in TechIdRe.Matches(body))
        {
            IocItem? item = store.Add("technique", m.Value.ToUpperInvariant(), source);
            if (item is not null) { item.Mitre = MitreUrl(m.Value); }
        }

        foreach (Match m in UrlRe.Matches(body))
        {
            store.Add("url", m.Value.TrimEnd('.', ',', ';'), source);
        }

        var emails = EmailRe.Matches(body)
            .Select(m => m.Value.ToLowerInvariant())
            .ToHashSet(StringComparer.Ordinal);

        foreach (Match m in DomainRe.Matches(body))
        {
            string d = m.Value.ToLowerInvariant();
            string tld = d[(d.LastIndexOf('.') + 1)..];

            if (FileExtensions.Contains(tld)) { continue; }
            if (NumericOnlyRe.IsMatch(d)) { continue; }
            if (emails.Any(e => e.Contains(d, StringComparison.Ordinal))) { continue; }

            AddDomain(store, d, source);
        }

        foreach (Match m in FileNameRe.Matches(body))
        {
            store.Add("filename", m.Value.Trim(), source);
        }
    }

    // ====================================================================
    // STIX parsing
    // ====================================================================

    private static string? Str(JsonElement obj, string property) =>
        obj.ValueKind == JsonValueKind.Object
        && obj.TryGetProperty(property, out JsonElement v)
        && v.ValueKind == JsonValueKind.String
            ? v.GetString()
            : null;

    private static List<string> StrList(JsonElement obj, string property)
    {
        var list = new List<string>();

        if (obj.ValueKind == JsonValueKind.Object
            && obj.TryGetProperty(property, out JsonElement arr)
            && arr.ValueKind == JsonValueKind.Array)
        {
            foreach (JsonElement e in arr.EnumerateArray())
            {
                if (e.ValueKind == JsonValueKind.String)
                {
                    string? s = e.GetString();
                    if (!string.IsNullOrWhiteSpace(s)) { list.Add(s); }
                }
            }
        }

        return list;
    }

    private static string? HashCategory(string path)
    {
        Match m = HashPathRe.Match(path);
        if (!m.Success) { return null; }

        string key = m.Groups[1].Value.ToLowerInvariant().Replace("-", string.Empty);
        return HashTypes.TryGetValue(key, out string? cat) ? cat : null;
    }

    private static string ClassifyComparison(string objType, string path)
    {
        string t = objType.ToLowerInvariant();
        string p = path.ToLowerInvariant();

        switch (t)
        {
            case "ipv4-addr": return "ipv4";
            case "ipv6-addr": return "ipv6";
            case "domain-name": return "domain";
            case "url": return "url";
            case "email-addr": return "email";
            case "email-message" when p.Contains("value", StringComparison.Ordinal):
                return "email";
            case "windows-registry-key": return "registry";
            case "mutex": return "mutex";
        }

        if (t is "file" or "artifact")
        {
            if (p.StartsWith("hashes", StringComparison.Ordinal))
            {
                return HashCategory(path) ?? "other";
            }

            if (p == "name") { return "filename"; }
            if (p == "parent_directory_ref.path") { return "other"; }
        }

        if (t == "process")
        {
            if (p is "name" or "image_ref.name" or "binary_ref.name") { return "filename"; }
            if (p.Contains("command_line", StringComparison.Ordinal)) { return "commandline"; }
        }

        return "other";
    }

    private readonly record struct Comparison(
        string Category, string Value, string ObjType, string Path);

    private static List<Comparison> ParsePattern(string? pattern)
    {
        var found = new List<Comparison>();
        if (string.IsNullOrEmpty(pattern)) { return found; }

        foreach (Match m in PatternRe.Matches(pattern))
        {
            string objType = m.Groups[1].Value;
            string path = m.Groups[2].Value;
            string value = m.Groups[3].Value
                .Replace("\\'", "'", StringComparison.Ordinal)
                .Replace("\\\\", "\\", StringComparison.Ordinal)
                .Trim();

            found.Add(new Comparison(ClassifyComparison(objType, path), value, objType, path));
        }

        return found;
    }

    private static (string Short, string Full, string Published) ReportLabel(
        List<JsonElement> objects, string fileName)
    {
        string? advisoryId = null;
        Match m = AdvisoryIdRe.Match(fileName);
        if (m.Success) { advisoryId = m.Value.ToUpperInvariant(); }

        JsonElement? report = objects.FirstOrDefault(o => Str(o, "type") == "report");
        string? title = report is null ? null : Str(report.Value, "name");

        if (advisoryId is null && title is not null)
        {
            Match t = AdvisoryIdRe.Match(title);
            if (t.Success) { advisoryId = t.Value.ToUpperInvariant(); }
        }

        int dot = fileName.LastIndexOf('.');
        string stem = dot > 0 ? fileName[..dot] : fileName;
        string cleanTitle = StopRansomwareRe.Replace(title ?? string.Empty, string.Empty).Trim();

        string shortName;
        if (advisoryId is not null)
        {
            shortName = advisoryId;
        }
        else if (cleanTitle.Length > 0 && PastedNameRe.IsMatch(stem))
        {
            shortName = Clip(cleanTitle, 40);
        }
        else
        {
            shortName = Clip(stem, 40);
        }

        string full = title ?? fileName;
        if (advisoryId is not null
            && !full.Contains(advisoryId, StringComparison.OrdinalIgnoreCase))
        {
            full = $"{advisoryId} {full}";
        }

        string published = string.Empty;
        if (report is not null)
        {
            string? pub = Str(report.Value, "published");
            if (!string.IsNullOrEmpty(pub)) { published = Clip(pub, 10); }
        }

        return (shortName, full, published);
    }

    private static ReportInfo ParseStix(JsonElement root, string fileName, IocStore store)
    {
        var objects = new List<JsonElement>();

        if (root.ValueKind == JsonValueKind.Array)
        {
            objects.AddRange(root.EnumerateArray());
        }
        else if (root.TryGetProperty("objects", out JsonElement arr)
                 && arr.ValueKind == JsonValueKind.Array)
        {
            objects.AddRange(arr.EnumerateArray());
        }
        else
        {
            objects.Add(root);
        }

        (string source, string title, string published) = ReportLabel(objects, fileName);
        int indicators = 0;

        foreach (JsonElement o in objects)
        {
            if (o.ValueKind != JsonValueKind.Object) { continue; }

            string type = (Str(o, "type") ?? string.Empty).ToLowerInvariant();
            string description = Str(o, "description") ?? string.Empty;

            switch (type)
            {
                case "indicator":
                    indicators++;
                    ParseIndicator(o, description, source, store);
                    break;

                case "vulnerability":
                    foreach (Match c in CveRe.Matches(Str(o, "name") ?? string.Empty))
                    {
                        AddCve(store, c.Value, source);
                    }

                    foreach (JsonElement reference in ExternalReferences(o))
                    {
                        if (string.Equals(Str(reference, "source_name"), "cve",
                                          StringComparison.OrdinalIgnoreCase))
                        {
                            string? id = Str(reference, "external_id");
                            if (!string.IsNullOrEmpty(id)) { AddCve(store, id, source); }
                        }
                    }

                    break;

                case "malware":
                case "tool":
                    List<string> types = StrList(o, "malware_types");
                    if (types.Count == 0) { types = StrList(o, "tool_types"); }
                    AddSoftware(store, Str(o, "name"), source, type, types, StrList(o, "aliases"));
                    break;

                case "threat-actor":
                case "intrusion-set":
                case "campaign":
                    string? actor = Str(o, "name");
                    if (!string.IsNullOrWhiteSpace(actor) && !SkipNames.Contains(actor))
                    {
                        store.Add("actor", actor, source,
                                  CultureInfo.InvariantCulture.TextInfo
                                      .ToTitleCase(type.Replace("-", " ")),
                                  StrList(o, "aliases"));
                    }

                    break;

                case "attack-pattern":
                    ParseAttackPattern(o, source, store);
                    break;

                case "ipv4-addr":
                case "ipv6-addr":
                    AddAddress(store, Str(o, "value"), source);
                    break;

                case "domain-name":
                    AddDomain(store, Str(o, "value"), source);
                    break;

                case "url":
                    store.Add("url", Str(o, "value"), source);
                    break;

                case "email-addr":
                    store.Add("email", Str(o, "value"), source);
                    break;

                case "file":
                    ParseFileObject(o, source, store);
                    break;

                case "windows-registry-key":
                    store.Add("registry", Str(o, "key"), source);
                    break;

                case "mutex":
                    store.Add("mutex", Str(o, "name"), source);
                    break;

                case "report":
                case "note":
                case "observed-data":
                case "opinion":
                    TextSweep(store, description.Length > 0 ? description : Str(o, "content"),
                              source);
                    break;
            }
        }

        return new ReportInfo
        {
            Source = source,
            Title = title,
            Published = published,
            File = fileName,
            Indicators = indicators,
            Objects = objects.Count,
            Note = string.Empty,
        };
    }

    private static IEnumerable<JsonElement> ExternalReferences(JsonElement obj) =>
        obj.TryGetProperty("external_references", out JsonElement refs)
        && refs.ValueKind == JsonValueKind.Array
            ? refs.EnumerateArray()
            : Enumerable.Empty<JsonElement>();

    private static void ParseIndicator(JsonElement o, string description, string source,
                                       IocStore store)
    {
        List<Comparison> comps = ParsePattern(Str(o, "pattern"));

        List<string> names = comps.Where(c => c.Category == "filename")
                                  .Select(c => c.Value).ToList();
        List<string> hashes = comps.Where(c => HashTypes.ContainsKey(c.Category))
                                   .Select(c => c.Value.ToLowerInvariant()).ToList();

        string? context = null;
        string trimmed = description.Trim();

        if (trimmed.Length > 0 && trimmed.Length < 200 && !Ipv4Re.IsMatch(trimmed))
        {
            context = trimmed;
        }

        string? name = Str(o, "name");
        if (context is null && name is not null && name.Length < 200) { context = name; }

        foreach (Comparison c in comps)
        {
            switch (c.Category)
            {
                case "ipv4":
                case "ipv6":
                    AddAddress(store, c.Value, source, context);
                    break;

                case "domain":
                    AddDomain(store, c.Value, source, context);
                    break;

                case "filename":
                    store.Add(c.Category, c.Value, source,
                              context ?? (hashes.Count > 0 ? "Has a hash IOC" : null), hashes);
                    break;

                case "other":
                    IocItem? other = store.Add("other", $"{c.ObjType}:{c.Path} = {c.Value}",
                                               source, context);
                    if (other is not null) { other.Raw = c.Value; }
                    break;

                default:
                    if (HashTypes.ContainsKey(c.Category))
                    {
                        string? ctx = context;
                        if (names.Count > 0)
                        {
                            ctx = "File: " + string.Join(", ", names)
                                + (context is not null ? $" ({context})" : string.Empty);
                        }

                        var related = hashes
                            .Where(h => !string.Equals(h, c.Value, StringComparison.OrdinalIgnoreCase))
                            .Concat(names).ToList();

                        store.Add(c.Category, c.Value, source, ctx, related);
                    }
                    else
                    {
                        store.Add(c.Category, c.Value, source, context);
                    }

                    break;
            }
        }

        if (comps.Count == 0)
        {
            string? pattern = Str(o, "pattern");
            if (!string.IsNullOrEmpty(pattern)) { TextSweep(store, pattern, source, deep: true); }
        }

        // descriptions sometimes carry extra indicators, e.g. "SHA256 of <sha1>"
        TextSweep(store, description, source);
    }

    private static void ParseAttackPattern(JsonElement o, string source, IocStore store)
    {
        string name = Str(o, "name") ?? string.Empty;
        string? techniqueId = null;
        string context = name;

        Match m = TechNameRe.Match(name);
        if (m.Success)
        {
            techniqueId = m.Groups["id"].Value;
            context = $"{m.Groups["tactic"].Value.Trim()}: {m.Groups["name"].Value.Trim()}";
        }
        else
        {
            foreach (JsonElement reference in ExternalReferences(o))
            {
                string sourceName = Str(reference, "source_name") ?? string.Empty;
                string? id = Str(reference, "external_id");

                if (sourceName.StartsWith("mitre", StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrEmpty(id))
                {
                    techniqueId = id;
                }
            }

            if (techniqueId is null)
            {
                Match fallback = TechIdRe.Match(name);
                if (fallback.Success) { techniqueId = fallback.Value; }
            }
        }

        if (techniqueId is null) { return; }

        IocItem? item = store.Add("technique", techniqueId.ToUpperInvariant(), source, context);
        if (item is not null) { item.Mitre = MitreUrl(techniqueId); }
    }

    private static void ParseFileObject(JsonElement o, string source, IocStore store)
    {
        string? fileName = Str(o, "name");
        var values = new List<string>();

        if (o.TryGetProperty("hashes", out JsonElement hashes)
            && hashes.ValueKind == JsonValueKind.Object)
        {
            foreach (System.Text.Json.JsonProperty h in hashes.EnumerateObject())
            {
                if (h.Value.ValueKind != JsonValueKind.String) { continue; }

                string? value = h.Value.GetString();
                if (string.IsNullOrWhiteSpace(value)) { continue; }

                values.Add(value.ToLowerInvariant());

                string key = h.Name.ToLowerInvariant().Replace("-", string.Empty);
                if (HashTypes.TryGetValue(key, out string? cat))
                {
                    store.Add(cat, value, source,
                              fileName is not null ? $"File: {fileName}" : null,
                              fileName is not null ? new[] { fileName } : null);
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(fileName))
        {
            store.Add("filename", fileName, source, null, values);
        }
    }

    // ====================================================================
    // search definitions  --  IOCExcavator.searches.json
    // ====================================================================

    private const string SearchFileName = "IOCExcavator.searches.json";

    private const long MaxSearchFileBytes = 512L * 1024;
    private const int MaxSearchesPerCategory = 12;

    private sealed class SearchDef
    {
        public string Name { get; set; } = "Broad search";
        public string? Note { get; set; }
        public string Template { get; set; } = "{scope} ({terms})";
        public string Item { get; set; } = "{value}";
        public string Separator { get; set; } = " OR ";
        public string? Scope { get; set; }

        /// <summary>"search" for the derived hunt terms, "values" for the literal list.</summary>
        public string Source { get; set; } = "search";

        /// <summary>"all", "clean" to drop the flagged noisy indicators, or "flagged".</summary>
        public string Include { get; set; } = "all";

        /// <summary>Cap on indicators in one search. Zero means no cap.</summary>
        public int MaxTerms { get; set; }
    }

    private sealed class SearchBook
    {
        public string DefaultScope { get; set; } = "index=*";

        public List<SearchDef> Combined { get; set; } = new() { new SearchDef { Name = "Combined search" } };

        public Dictionary<string, List<SearchDef>> ByKey { get; } =
            new(StringComparer.OrdinalIgnoreCase);

        public bool FromFile { get; set; }

        public int Customised { get; set; }

        public string? Problem { get; set; }

        public List<string> UnknownKeys { get; } = new();
    }

    private static readonly HashSet<string> CategoryKeys =
        new(Categories.Select(c => c.Key), StringComparer.OrdinalIgnoreCase);

    /// <summary>The behaviour before the file existed: one broad search per category.</summary>
    private static SearchBook BuiltInBook()
    {
        var book = new SearchBook();
        FillMissing(book);
        return book;
    }

    private static void FillMissing(SearchBook book)
    {
        foreach ((string key, _, _) in Categories)
        {
            if (book.ByKey.ContainsKey(key)) { continue; }

            book.ByKey[key] = NoSearch.Contains(key)
                ? new List<SearchDef>()
                : new List<SearchDef> { new SearchDef() };
        }
    }

    private static readonly object searchBookLock = new();
    private static SearchBook? cachedBook;
    private static string cachedStamp = string.Empty;

    /// <summary>Re-parses only when the file's stamp changes, so an edit is picked up on the next Extract without a restart.</summary>
    private static SearchBook LoadSearchBook(string contentRoot)
    {
        string path = System.IO.Path.Combine(
            contentRoot, "Components", "Pages", "IOCExcavator", SearchFileName);

        string stamp;
        try
        {
            var info = new System.IO.FileInfo(path);
            stamp = info.Exists
                ? info.LastWriteTimeUtc.Ticks.ToString(CultureInfo.InvariantCulture)
                  + ":" + info.Length.ToString(CultureInfo.InvariantCulture)
                : "missing";
        }
        catch (Exception)
        {
            //Log.Error(ex, "Uh oh! IOCExcavator.razor -> LoadSearchBook() has caught an exception!");
            stamp = "unreadable";
        }

        lock (searchBookLock)
        {
            if (cachedBook is not null && cachedStamp == stamp) { return cachedBook; }

            cachedBook = ReadSearchBook(path);
            cachedStamp = stamp;
            return cachedBook;
        }
    }

    /// <summary>Every failure path returns a usable book: a mistyped file leaves the page working, with the reason on screen.</summary>
    private static SearchBook ReadSearchBook(string path)
    {
        var book = new SearchBook();

        try
        {
            var info = new System.IO.FileInfo(path);

            if (!info.Exists)
            {
                FillMissing(book);
                return book;
            }

            if (info.Length > MaxSearchFileBytes)
            {
                book.Problem = $"IOCExcavator.searches.json is over "
                    + $"{MaxSearchFileBytes / 1024} KB and was not read. "
                    + "The built-in searches are in use.";
                FillMissing(book);
                return book;
            }

            string text = System.IO.File.ReadAllText(path, Encoding.UTF8);
            using JsonDocument doc = JsonDocument.Parse(text, JsonOptions);
            JsonElement root = doc.RootElement;

            if (root.ValueKind != JsonValueKind.Object)
            {
                book.Problem = "IOCExcavator.searches.json must hold a JSON object. "
                    + "The built-in searches are in use.";
                FillMissing(book);
                return book;
            }

            string? scope = Str(root, "defaultScope");
            if (!string.IsNullOrWhiteSpace(scope))
            {
                book.DefaultScope = Clip(scope.Trim(), 500);
            }

            if (root.TryGetProperty("combined", out JsonElement combined))
            {
                // An array of searches, or a single object for the common case.
                if (combined.ValueKind == JsonValueKind.Array)
                {
                    var defs = new List<SearchDef>();
                    foreach (JsonElement item in combined.EnumerateArray())
                    {
                        if (defs.Count >= MaxSearchesPerCategory) { break; }
                        if (item.ValueKind != JsonValueKind.Object) { continue; }

                        defs.Add(ReadSearchDef(item, "Combined " + (defs.Count + 1)));
                    }

                    if (defs.Count > 0) { book.Combined = defs; }
                }
                else if (combined.ValueKind == JsonValueKind.Object)
                {
                    book.Combined = new List<SearchDef>
                    {
                        ReadSearchDef(combined, "Combined search"),
                    };
                }
            }

            if (root.TryGetProperty("searches", out JsonElement searches)
                && searches.ValueKind == JsonValueKind.Object)
            {
                foreach (System.Text.Json.JsonProperty entry in searches.EnumerateObject())
                {
                    if (!CategoryKeys.Contains(entry.Name))
                    {
                        if (book.UnknownKeys.Count < 10)
                        {
                            book.UnknownKeys.Add(Clip(entry.Name, 40));
                        }

                        continue;
                    }

                    if (entry.Value.ValueKind != JsonValueKind.Array) { continue; }

                    var defs = new List<SearchDef>();
                    foreach (JsonElement item in entry.Value.EnumerateArray())
                    {
                        if (defs.Count >= MaxSearchesPerCategory) { break; }
                        if (item.ValueKind != JsonValueKind.Object) { continue; }

                        defs.Add(ReadSearchDef(item, "Search " + (defs.Count + 1)));
                    }

                    book.ByKey[entry.Name] = defs;
                    book.Customised++;
                }
            }

            book.FromFile = true;
            FillMissing(book);
            return book;
        }
        catch (System.Text.Json.JsonException ex)
        {
            book.Problem = "IOCExcavator.searches.json is not valid JSON (" + ex.Message
                + "). The built-in searches are in use.";
        }
        catch (Exception ex)
        {
            //Log.Error(ex, "Uh oh! IOCExcavator.razor -> ReadSearchBook() has caught an exception!");
            book.Problem = "IOCExcavator.searches.json could not be read (" + ex.Message
                + "). The built-in searches are in use.";
        }

        var fallback = new SearchBook { Problem = book.Problem };
        FillMissing(fallback);
        return fallback;
    }

    private static SearchDef ReadSearchDef(JsonElement element, string fallbackName)
    {
        var def = new SearchDef();

        string? name = Str(element, "name");
        def.Name = string.IsNullOrWhiteSpace(name) ? fallbackName : Clip(name.Trim(), 80);

        string? note = Str(element, "note");
        def.Note = string.IsNullOrWhiteSpace(note) ? null : Clip(note.Trim(), 300);

        // Without {terms} this would be a bare scope, which matches every event in the index.
        string? template = Str(element, "template");
        def.Template = template is not null && template.Contains("{terms}", StringComparison.Ordinal)
            ? Clip(template, 1000)
            : "{scope} ({terms})";

        string? item = Str(element, "item");
        def.Item = item is not null && item.Contains("{value}", StringComparison.Ordinal)
            ? Clip(item, 200)
            : "{value}";

        if (element.TryGetProperty("separator", out JsonElement separator)
            && separator.ValueKind == JsonValueKind.String)
        {
            def.Separator = Clip(separator.GetString() ?? " OR ", 20);
        }

        string? scope = Str(element, "scope");
        def.Scope = string.IsNullOrWhiteSpace(scope) ? null : Clip(scope.Trim(), 500);

        def.Source = string.Equals(Str(element, "source"), "values", StringComparison.OrdinalIgnoreCase)
            ? "values"
            : "search";

        string include = (Str(element, "include") ?? string.Empty).Trim().ToLowerInvariant();
        def.Include = include is "clean" or "flagged" ? include : "all";

        if (element.TryGetProperty("maxTerms", out JsonElement maxTerms)
            && maxTerms.ValueKind == JsonValueKind.Number
            && maxTerms.TryGetInt32(out int cap)
            && cap > 0)
        {
            def.MaxTerms = Math.Min(cap, MaxItemsPerCategory);
        }

        return def;
    }

    private static string Clip(string value, int max) =>
        value.Length <= max ? value : value[..max];

    // ====================================================================
    // Splunk search building
    // ====================================================================

    private static string Quote(string value) =>
        "\"" + value.Replace("\\", "\\\\", StringComparison.Ordinal)
                    .Replace("\"", "\\\"", StringComparison.Ordinal) + "\"";

    private static List<string> Dedupe(IEnumerable<string> values)
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var output = new List<string>();

        foreach (string value in values)
        {
            string v = (value ?? string.Empty).Trim();
            if (v.Length > 0 && seen.Add(v)) { output.Add(v); }
        }

        return output;
    }

    /// <summary>The values worth searching, which are not always the values shown: a tool is searched by its executable names.</summary>
    private static List<string> SearchTerms(string key, List<IocItem> items)
    {
        switch (key)
        {
            case "tool":
                var terms = new List<string>();
                foreach (IocItem i in items)
                {
                    ToolInfo? tool = LookupTool(i.Value);
                    if (tool is not null)
                    {
                        terms.AddRange(tool.Processes);
                        terms.AddRange(tool.Keywords);
                    }
                    else
                    {
                        terms.Add(i.Value);
                    }
                }

                return Dedupe(terms);

            case "other":
                return Dedupe(items.Select(i => i.Raw ?? i.Value));

            case "malware":
                return Dedupe(items.Select(i =>
                    TrailingRansomwareRe.Replace(i.Value, string.Empty)));

            default:
                return Dedupe(items.Select(i => i.Value));
        }
    }

    private static string ResolveScope(string? scope, string fallback) =>
        Clip(string.IsNullOrWhiteSpace(scope) ? fallback : scope.Trim(), 500);

    /// <summary>Renders one definition. Only the template comes from the file; every indicator still goes through Quote.</summary>
    private static BuiltSearch? BuildSearch(SearchDef def, string key, List<IocItem> items, string scope)
    {
        List<IocItem> pool = def.Include switch
        {
            "clean" => items.Where(i => !i.Flagged).ToList(),
            "flagged" => items.Where(i => i.Flagged).ToList(),
            _ => items,
        };

        if (pool.Count == 0) { return null; }

        List<string> terms = def.Source == "values"
            ? Dedupe(pool.Select(i => i.Value))
            : SearchTerms(key, pool);

        if (def.MaxTerms > 0 && terms.Count > def.MaxTerms)
        {
            terms = terms.Take(def.MaxTerms).ToList();
        }

        if (terms.Count == 0) { return null; }

        string joined = string.Join(
            def.Separator,
            terms.Select(t => def.Item.Replace("{value}", Quote(t), StringComparison.Ordinal)));

        return new BuiltSearch
        {
            Name = def.Name,
            Note = def.Note,
            Terms = terms.Count,
            Spl = def.Template
                .Replace("{scope}", def.Scope ?? scope, StringComparison.Ordinal)
                .Replace("{terms}", joined, StringComparison.Ordinal),
        };
    }

    /// <summary>Turns the store into the display list. No pipes or time modifiers: a bare search pastes anywhere.</summary>
    private static List<IocCategory> BuildCategories(IocStore store, string? scope, SearchBook book)
    {
        string searchScope = ResolveScope(scope, book.DefaultScope);

        var output = new List<IocCategory>();

        foreach ((string key, string label, string group) in Categories)
        {
            List<IocItem> items = store.Items(key);
            if (items.Count == 0) { continue; }

            var category = new IocCategory
            {
                Key = key,
                Label = label,
                Group = group,
                Items = items,
            };

            if (book.ByKey.TryGetValue(key, out List<SearchDef>? defs))
            {
                foreach (SearchDef def in defs)
                {
                    BuiltSearch? built = BuildSearch(def, key, items, searchScope);
                    if (built is not null) { category.Searches.Add(built); }
                }
            }

            if (key == "tool")
            {
                var noisy = items
                    .Where(i => LookupTool(i.Value)?.Noisy == true)
                    .Select(i => i.Value)
                    .ToList();

                if (noisy.Count > 0)
                {
                    category.Note = "Expect plenty of benign hits for "
                        + string.Join(", ", noisy)
                        + ": they are legitimate and present on most hosts.";
                }
            }

            output.Add(category);
        }

        return output;
    }
}
