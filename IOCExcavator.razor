    private static string Tsv(IEnumerable<IocCategory> cats, bool header)
    {
        var sb = new StringBuilder();
        if (header) { sb.AppendLine("Category\tValue\tContext\tRelated\tSource"); }

        foreach (IocCategory c in cats)
        {
            foreach (IocItem i in c.Items)
            {
                sb.Append(Cell(c.Label)).Append('\t')
                  .Append(Cell(i.Value)).Append('\t')
                  .Append(Cell(string.Join("; ", i.Context))).Append('\t')
                  .Append(Cell(string.Join("; ", i.Related))).Append('\t')
                  .Append(Cell(string.Join("; ", i.Sources))).Append('\n');
            }
        }

        return sb.ToString().TrimEnd('\n');
    }

    /// <summary>Defuses spreadsheet formula injection: Excel executes a cell starting with = + - @ or a control character.</summary>
    private static string Cell(string? value)
    {
        string s = (value ?? string.Empty).Replace('\t', ' ')
                                          .Replace('\r', ' ')
                                          .Replace('\n', ' ')
                                          .Trim();

        return s.Length > 0 && "=+-@".IndexOf(s[0]) >= 0 ? "'" + s : s;
    }

    private static string CsvCell(string? value)
    {
        string s = Cell(value);
        return "\"" + s.Replace("\"", "\"\"") + "\"";
    }

    private async Task ExportAsync(string kind)
    {
        if (jsModule is null || categories.Count == 0) { return; }

        string stamp = DateTime.Now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        string name;
        string mime;
        var sb = new StringBuilder();

        if (kind == "spl")
        {
            foreach (IocCategory c in categories.Where(c => c.Searchable))
            {
                sb.AppendLine($"### {c.Label} ({c.Items.Count})");
                if (c.Note is not null) { sb.AppendLine($"# {c.Note}"); }

                foreach (BuiltSearch s in c.Searches)
                {
                    sb.AppendLine($"# {s.Name} -- {s.Terms} term{(s.Terms == 1 ? "" : "s")}");
                    if (s.Note is not null) { sb.AppendLine($"# {s.Note}"); }
                    sb.AppendLine(s.Spl);
                    sb.AppendLine();
                }
            }

            if (combinedSearches.Count > 0)
            {
                sb.AppendLine("### Combined: "
                    + string.Join(" + ", CombineSelection().Select(c => c.Label)));

                foreach (BuiltSearch s in combinedSearches)
                {
                    sb.AppendLine($"# {s.Name} -- {s.Terms} term{(s.Terms == 1 ? "" : "s")}");
                    if (s.Note is not null) { sb.AppendLine($"# {s.Note}"); }
                    sb.AppendLine(s.Spl);
                    sb.AppendLine();
                }
            }

            name = $"splunk_searches_{stamp}.txt";
            mime = "text/plain";
        }
        else
        {
            // UTF-8 BOM so Excel opens non-ASCII values correctly
            sb.Append('\uFEFF');
            sb.Append("Category,Value,Context,Related,Source\r\n");

            foreach (IocCategory c in categories)
            {
                foreach (IocItem i in c.Items)
                {
                    sb.Append(CsvCell(c.Label)).Append(',')
                      .Append(CsvCell(i.Value)).Append(',')
                      .Append(CsvCell(string.Join("; ", i.Context))).Append(',')
                      .Append(CsvCell(string.Join("; ", i.Related))).Append(',')
                      .Append(CsvCell(string.Join("; ", i.Sources))).Append("\r\n");
                }
            }

            name = $"cisa_iocs_{stamp}.csv";
            mime = "text/csv";
        }

        try
        {
            await jsModule.InvokeVoidAsync("downloadText", name, mime, sb.ToString());
        }
        catch (Exception)
        {
            //Log.Error(ex, "Uh oh! IOCExcavator.razor -> ExportAsync() has caught an exception!");
        }
    }

