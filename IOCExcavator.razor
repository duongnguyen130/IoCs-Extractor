@page "/IOCExcavator"
@attribute [NavigationItem("IOC Excavator", NavigationIcon.IOCExcavator, Order = 82)]
@namespace WebApp.Components.Pages.IOCExcavator
@attribute [PagePermissionTitle("IOC Excavator")]
@implements IDisposable
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Net
@using System.Net.Sockets
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions

@*
    Needs an interactive render mode. On a .NET 8 Blazor Web App with per-page
    modes, uncomment:  @rendermode InteractiveServer
    On classic Blazor Server the page is already interactive.
*@

<PageHeader PageTitle="IOC Excavator" />
<PageTitle>IOC Excavator</PageTitle>

@*START HTML*@

<div class="ioc-excavator">

    <section class="ix-card ix-intake">

        <div class="ix-dropzone">
            <InputFile OnChange="OnFilesChosen" multiple class="ix-fileinput" />
            <div class="ix-dropzone-inner">
                <div class="ix-dropzone-icon" aria-hidden="true"></div>
                <p class="ix-dropzone-title">Drop advisories here, or click to browse</p>
            </div>
        </div>

        @if (queued.Count > 0)
        {
            <ul class="ix-filelist">
                @foreach (QueuedFile q in queued)
                {
                    QueuedFile item = q;
                    <li>
                        <span class="ix-fname">
                            @if (item.Pasted)
                            {
                                <span class="ix-tag">pasted</span>
                            }
                            @item.Name
                        </span>
                        <span class="ix-fsize">@Kb(item.Bytes.Length)</span>
                        <button type="button" class="ix-remove" title="Remove"
                                aria-label="@RemoveLabel(item.Name)"
                                @onclick="() => RemoveFile(item)">&times;</button>
                    </li>
                }
            </ul>
        }

        <details class="ix-paste">
            <summary>Paste STIX JSON or an IOC list instead</summary>
            <div class="ix-paste-inner">
                <label class="ix-field">
                    <span>Name (optional)</span>
                    <input type="text" @bind="pasteName" placeholder="e.g. AA26-293A"
                           spellcheck="false" autocomplete="off" />
                </label>
                <label class="ix-field">
                    <span>Content</span>
                    <textarea @bind="pasteText" @bind:event="oninput" rows="7"
                              spellcheck="false" autocomplete="off"
                              placeholder="Raw STIX JSON, or plain text holding IPs, hashes, URLs and CVEs."></textarea>
                </label>
                <div class="ix-paste-foot">
                    <span class="ix-hint @PasteHintClass()">@PasteHint()</span>
                    <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                            disabled="@(pasteText.Trim().Length == 0)"
                            @onclick="AddPasted">Add pasted content</button>
                </div>
            </div>
        </details>

        <div class="ix-controls">
            <label class="ix-stepper">
                <span>Splunk scope</span>
                <input type="text" @bind="splunkScope" spellcheck="false" autocomplete="off" />
            </label>

            <div class="ix-actions">
                <button type="button" class="ix-btn ix-btn-ghost" @onclick="Wipe">Clear</button>
                <button type="button" class="ix-btn ix-btn-primary"
                        @onclick="ExtractAsync" disabled="@(isBusy || queued.Count == 0)">
                    @(isBusy ? "Extracting..." : "Extract IOCs")
                </button>
            </div>
        </div>
    </section>

    @if (errorMessage is not null)
    {
        <div class="ix-err">@errorMessage</div>
    }
    else if (categories.Count > 0)
    {
        <section class="ix-results">

            <div class="ix-stats">
                <div class="ix-stat"><b>@totalItems</b><span>indicators</span></div>
                @foreach (var g in GroupTotals())
                {
                    <div class="ix-stat ix-stat-group @GroupClass(g.Group)">
                        <b>@g.Count</b><span>@g.Group</span>
                    </div>
                }
            </div>

            @if (flaggedCount > 0)
            {
                <div class="ix-notice">
                    <span aria-hidden="true">&#9679;</span>
                    <div>
                        <b>@flaggedCount item@(flaggedCount == 1 ? "" : "s") will hit benign traffic.</b>
                        Shared CDN and cloud ranges, plus admin tools that live on most
                        hosts. They are still real IOCs; they just need a tighter scope.
                    </div>
                </div>
            }

            @foreach (ReportInfo r in reports)
            {
                <div class="ix-notice ix-notice-quiet">
                    <span aria-hidden="true">&#9675;</span>
                    <div>
                        <b>@r.Source</b>
                        @if (!string.IsNullOrEmpty(r.Title) && r.Title != r.Source)
                        {
                            <text> &mdash; @r.Title</text>
                        }
                        <span class="ix-meta">
                            @(string.IsNullOrEmpty(r.Published) ? "no date" : r.Published)
                            &middot; @r.Indicators indicator@(r.Indicators == 1 ? "" : "s")
                            &middot; @r.Objects object@(r.Objects == 1 ? "" : "s")
                            @if (!string.IsNullOrEmpty(r.Note))
                            {
                                <text> &middot; @r.Note</text>
                            }
                        </span>
                    </div>
                </div>
            }

            @foreach (string e in errors)
            {
                <div class="ix-notice ix-notice-quiet">
                    <span aria-hidden="true">&#9675;</span><div>@e</div>
                </div>
            }

            <div class="ix-toolbar">
                <div class="ix-segmented">
                    <button type="button" aria-pressed="@Pressed(activeGroup == "all")"
                            @onclick='() => activeGroup = "all"'>all</button>
                    @foreach (var g in GroupTotals())
                    {
                        string name = g.Group;
                        <button type="button" class="@SegClass(name)"
                                aria-pressed="@Pressed(activeGroup == name)"
                                @onclick="() => activeGroup = name">@ShortGroup(name)</button>
                    }
                </div>

                <div class="ix-right">
                    <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                            @onclick="CopyAllAsync">
                        @(copiedKey == "__all" ? "Copied" : "Copy table")
                    </button>
                    <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                            @onclick='() => ExportAsync("csv")'>CSV</button>
                    <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                            @onclick='() => ExportAsync("spl")'>SPL</button>
                    <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                            @onclick="Wipe">Wipe</button>
                </div>
            </div>

            @if (combineKeys.Count > 0)
            {
                <article class="ix-cat ix-combined">
                    <div class="ix-cat-head">
                        <span class="ix-label">Combined search</span>
                        <span class="ix-badge">@combineKeys.Count</span>
                        <span class="ix-group-tag">categories</span>

                        <div class="ix-right">
                            <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                                    @onclick="ClearCombine">Clear</button>
                        </div>
                    </div>

                    <div class="ix-cat-body">
                        <div class="ix-chips">
                            @foreach (IocCategory s in CombineSelection())
                            {
                                <span class="ix-chip @GroupClass(s.Group)">@s.Label</span>
                            }
                        </div>

                        @if (combinedSearches.Count == 0)
                        {
                            <div class="ix-cat-note">
                                Tick Combine on at least two categories to search them together.
                            </div>
                        }

                        @for (int ci = 0; ci < combinedSearches.Count; ci++)
                        {
                            BuiltSearch search = combinedSearches[ci];
                            string searchKey = "combined:" + ci;

                            <details class="ix-spl">
                                <summary>
                                    @search.Name
                                    <span class="ix-spl-count">@search.Terms terms</span>
                                </summary>
                                <div class="ix-spl-inner">
                                    @if (search.Note is not null)
                                    {
                                        <p class="ix-spl-note">@search.Note</p>
                                    }
                                    <pre>@search.Spl</pre>
                                    <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                                            @onclick="() => CopySearchAsync(search, searchKey)">
                                        @(copiedKey == searchKey ? "Copied" : "Copy SPL")
                                    </button>
                                </div>
                            </details>
                        }
                    </div>
                </article>
            }

            @foreach (IocCategory c in VisibleCategories())
            {
                IocCategory cat = c;

                <article class="ix-cat @GroupClass(cat.Group)">
                    <div class="ix-cat-head">
                        <span class="ix-label">@cat.Label</span>
                        <span class="ix-badge">@cat.Items.Count</span>
                        <span class="ix-group-tag">@cat.Group</span>

                        <div class="ix-right">
                            @if (cat.Searchable)
                            {
                                <label class="ix-combine" title="Add this category to the combined search">
                                    <input type="checkbox" checked="@combineKeys.Contains(cat.Key)"
                                           @onchange="() => ToggleCombine(cat.Key)" />
                                    <span>Combine</span>
                                </label>
                            }
                            <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                                    @onclick="() => CopyListAsync(cat)">
                                @(copiedKey == cat.Key + ":list" ? "Copied" : "Copy list")
                            </button>
                            <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                                    @onclick="() => CopyTableAsync(cat)">
                                @(copiedKey == cat.Key + ":table" ? "Copied" : "Copy with context")
                            </button>
                        </div>
                    </div>

                    <div class="ix-cat-body">
                        @if (cat.Note is not null)
                        {
                            <div class="ix-cat-note">@cat.Note</div>
                        }

                        <div class="ix-items">
                            @foreach (IocItem i in cat.Items.Take(MaxRowsShown))
                            {
                                IocItem row = i;
                                <div class="ix-item">
                                    <button type="button"
                                            class="@ValueClass(row)"
                                            title="Click to copy this value"
                                            @onclick="() => CopyValueAsync(row.Value, cat.Key)">@row.Value</button>

                                    @if (row.Related.Count > 0)
                                    {
                                        <span class="ix-rel">&rarr; @string.Join(", ", row.Related)</span>
                                    }
                                    @foreach (string s in row.Sources)
                                    {
                                        <span class="ix-src">@s</span>
                                    }
                                    @if (row.Nvd is not null)
                                    {
                                        <a class="ix-link" href="@row.Nvd" target="_blank" rel="noopener noreferrer">NVD</a>
                                        <a class="ix-link" href="@row.Kev" target="_blank" rel="noopener noreferrer">KEV</a>
                                    }
                                    @if (row.Mitre is not null)
                                    {
                                        <a class="ix-link" href="@row.Mitre" target="_blank" rel="noopener noreferrer">ATT&amp;CK</a>
                                    }
                                </div>
                            }
                        </div>

                        @if (cat.Items.Count > MaxRowsShown)
                        {
                            <div class="ix-cat-note">
                                Showing the first @MaxRowsShown of @cat.Items.Count.
                                Copy and export include all of them.
                            </div>
                        }

                        @for (int si = 0; si < cat.Searches.Count; si++)
                        {
                            BuiltSearch search = cat.Searches[si];
                            string searchKey = cat.Key + ":spl:" + si;

                            <details class="ix-spl">
                                <summary>
                                    @search.Name
                                    <span class="ix-spl-count">@search.Terms terms</span>
                                </summary>
                                <div class="ix-spl-inner">
                                    @if (search.Note is not null)
                                    {
                                        <p class="ix-spl-note">@search.Note</p>
                                    }
                                    <pre>@search.Spl</pre>
                                    <button type="button" class="ix-btn ix-btn-ghost ix-btn-sm"
                                            @onclick="() => CopySearchAsync(search, searchKey)">
                                        @(copiedKey == searchKey ? "Copied" : "Copy SPL")
                                    </button>
                                </div>
                            </details>
                        }
                    </div>
                </article>
            }

            @if (!VisibleCategories().Any())
            {
                <div class="ix-empty">
                    <strong>Nothing in this group</strong><span>Try another filter.</span>
                </div>
            }

            <p class="ix-srcline">@SearchSourceLine()</p>

        </section>
    }
    else if (hasExtracted)
    {
        <div class="ix-empty">
            <strong>No indicators found</strong>
            <span>Nothing in those files matched a known IOC shape.</span>
        </div>
    }

</div>

@*END HTML*@

@code{
    [Inject] private IJSRuntime _jsRuntime { get; set; } = default!;

    [Inject] private Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env { get; set; } = default!;

    private IJSObjectReference jsModule { get; set; } = null!;

    // ====================================================================
    // page state
    // ====================================================================

    /// <summary>Largest single upload. Must not exceed the SignalR message cap.</summary>
    private const long MaxUploadBytes = 25L * 1024 * 1024;

    /// <summary>Ceiling across every queued file, so one batch cannot exhaust memory.</summary>
    private const long MaxTotalBytes = 60L * 1024 * 1024;

    private const int MaxFiles = 25;

    private const int MaxRowsShown = 500;

    /// <summary>Hard ceiling per category, so a pathological file cannot hang the page.</summary>
    private const int MaxItemsPerCategory = 20000;

    private readonly List<QueuedFile> queued = new();
    private string pasteText = string.Empty;
    private string pasteName = string.Empty;
    private string splunkScope = "index=*";

    private List<IocCategory> categories = new();
    private List<ReportInfo> reports = new();
    private List<string> errors = new();
    private int totalItems;
    private int flaggedCount;

    private string activeGroup = "all";
    private string? copiedKey;

    private readonly HashSet<string> combineKeys = new(StringComparer.Ordinal);

    private readonly List<BuiltSearch> combinedSearches = new();

    /// <summary>The scope the last run used, so combined and per-category searches agree.</summary>
    private string resolvedScope = "index=*";

    private SearchBook searchBook = BuiltInBook();

    private string? errorMessage;
    private bool isBusy;
    private bool hasExtracted;

    private sealed record QueuedFile(string Name, byte[] Bytes, bool Pasted);

    private static string Kb(int bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1048576 ? $"{bytes / 1024.0:N1} KB"
        : $"{bytes / 1048576.0:N1} MB";

    /// <summary>aria-pressed as a string: a C# bool renders as a boolean attribute and never matches.</summary>
    private static string Pressed(bool on) => on ? "true" : "false";

    /// <summary>Built here because nested quotes in a Razor attribute are a parsing hazard.</summary>
    private static string ValueClass(IocItem item) =>
        item.Flagged ? "ix-value ix-flagged" : "ix-value";

    private static string RemoveLabel(string fileName) => "Remove " + fileName;

    private static string ShortGroup(string group) => group switch
    {
        "Network" => "network",
        "Hashes" => "hashes",
        "Host Artifacts" => "host",
        "Tools & Malware" => "tools",
        "Vulnerabilities" => "cves",
        "Behaviors (TTPs)" => "ttps",
        _ => "other",
    };

    /// <summary>Sets --ix-accent only, which the stylesheet spends on a rail and a dot, never on text.</summary>
    private static string GroupClass(string group) => group switch
    {
        "Network" => "ix-g-net",
        "Hashes" => "ix-g-hash",
        "Host Artifacts" => "ix-g-host",
        "Tools & Malware" => "ix-g-tool",
        "Vulnerabilities" => "ix-g-cve",
        "Behaviors (TTPs)" => "ix-g-ttp",
        _ => "ix-g-other",
    };

    private static string SegClass(string group) => "ix-seg-dot " + GroupClass(group);

    private IEnumerable<(string Group, int Count)> GroupTotals() =>
        categories
            .GroupBy(c => c.Group)
            .Select(g => (Group: g.Key, Count: g.Sum(c => c.Items.Count)));

    private IEnumerable<IocCategory> VisibleCategories() =>
        activeGroup == "all"
            ? categories
            : categories.Where(c => c.Group == activeGroup);

    // ====================================================================
    // combined search
    // ====================================================================

    private List<IocCategory> CombineSelection() =>
        categories.Where(c => c.Searchable && combineKeys.Contains(c.Key)).ToList();

    private void ToggleCombine(string key)
    {
        if (!combineKeys.Remove(key)) { combineKeys.Add(key); }

        copiedKey = null;
        RebuildCombined();
    }

    private void ClearCombine()
    {
        combineKeys.Clear();
        copiedKey = null;
        RebuildCombined();
    }

    /// <summary>Merges the ticked categories. Terms are de-duplicated across them, so a value listed twice is searched once.</summary>
    private void RebuildCombined()
    {
        combinedSearches.Clear();

        List<IocCategory> picked = CombineSelection();
        if (picked.Count < 2) { return; }

        foreach (SearchDef def in searchBook.Combined)
        {
            var pooled = new List<string>();

            foreach (IocCategory c in picked)
            {
                List<IocItem> items = def.Include switch
                {
                    "clean" => c.Items.Where(i => !i.Flagged).ToList(),
                    "flagged" => c.Items.Where(i => i.Flagged).ToList(),
                    _ => c.Items,
                };

                if (items.Count == 0) { continue; }

                pooled.AddRange(def.Source == "values"
                    ? items.Select(i => i.Value)
                    : SearchTerms(c.Key, items));
            }

            List<string> merged = Dedupe(pooled);
            if (def.MaxTerms > 0 && merged.Count > def.MaxTerms)
            {
                merged = merged.Take(def.MaxTerms).ToList();
            }

            if (merged.Count == 0) { continue; }

            string joined = string.Join(
                def.Separator,
                merged.Select(t => def.Item.Replace("{value}", Quote(t), StringComparison.Ordinal)));

            combinedSearches.Add(new BuiltSearch
            {
                Name = def.Name,
                Note = def.Note,
                Terms = merged.Count,
                Spl = def.Template
                    .Replace("{scope}", def.Scope ?? resolvedScope, StringComparison.Ordinal)
                    .Replace("{terms}", joined, StringComparison.Ordinal),
            });
        }
    }

    private string PasteHint()
    {
        string t = pasteText.Trim();
        if (t.Length == 0) { return string.Empty; }

        if (t[0] is '{' or '[')
        {
            try
            {
                using JsonDocument doc = JsonDocument.Parse(t, JsonOptions);
                int n = CountIndicators(doc.RootElement);
                return $"Valid JSON, {n} indicator{(n == 1 ? "" : "s")}.";
            }
            catch (System.Text.Json.JsonException ex)
            {
                return $"Invalid JSON ({ex.Message}). It will be swept as plain text.";
            }
        }

        return "Plain text, swept with regex for IPs, domains, URLs, hashes and CVEs.";
    }

    private string PasteHintClass()
    {
        string t = pasteText.Trim();
        if (t.Length == 0 || t[0] is not ('{' or '[')) { return string.Empty; }

        try
        {
            using JsonDocument doc = JsonDocument.Parse(t, JsonOptions);
            return "ix-ok";
        }
        catch (System.Text.Json.JsonException)
        {
            return "ix-bad";
        }
    }

    private static int CountIndicators(JsonElement root)
    {
        IEnumerable<JsonElement> objs =
            root.ValueKind == JsonValueKind.Array ? root.EnumerateArray()
            : root.TryGetProperty("objects", out JsonElement arr) && arr.ValueKind == JsonValueKind.Array
                ? arr.EnumerateArray()
                : new[] { root };

        return objs.Count(o => o.ValueKind == JsonValueKind.Object
                            && Str(o, "type") == "indicator");
    }

    // ====================================================================
    // intake
    // ====================================================================

    private async Task OnFilesChosen(InputFileChangeEventArgs e)
    {
        errorMessage = null;

        foreach (IBrowserFile file in e.GetMultipleFiles(MaxFiles))
        {
            if (queued.Count >= MaxFiles)
            {
                errorMessage = $"Only {MaxFiles} files at a time. Extract these first.";
                break;
            }

            if (file.Size > MaxUploadBytes)
            {
                errors.Add($"{file.Name}: over {MaxUploadBytes / 1048576} MB, skipped.");
                continue;
            }

            if (queued.Sum(q => (long)q.Bytes.Length) + file.Size > MaxTotalBytes)
            {
                errorMessage = $"That batch exceeds {MaxTotalBytes / 1048576} MB in total.";
                break;
            }

            byte[]? bytes = await ReadFileAsync(file);
            if (bytes is null)
            {
                errors.Add($"{file.Name}: could not be read.");
                continue;
            }

            if (queued.Any(q => q.Name == file.Name && q.Bytes.Length == bytes.Length))
            {
                continue;
            }

            queued.Add(new QueuedFile(file.Name, bytes, false));
        }
    }

    /// <summary>Reads one upload, tolerating the short reads a browser stream returns.</summary>
    private static async Task<byte[]?> ReadFileAsync(IBrowserFile file)
    {
        try
        {
            byte[] buffer = new byte[file.Size];
            await using Stream stream = file.OpenReadStream(MaxUploadBytes);

            int filled = 0;
            while (filled < buffer.Length)
            {
                int read = await stream.ReadAsync(buffer.AsMemory(filled));
                if (read == 0) { break; }
                filled += read;
            }

            return filled == buffer.Length ? buffer : null;
        }
        catch (Exception)
        {
            //Log.Error(ex, "Uh oh! IOCExcavator.razor -> ReadFileAsync() has caught an exception!");
            return null;
        }
    }

    private void AddPasted()
    {
        string text = pasteText.Trim();
        if (text.Length == 0) { return; }

        bool looksJson = text[0] is '{' or '[';
        string baseName = pasteName.Trim();

        if (baseName.Length == 0)
        {
            Match m = AdvisoryIdRe.Match(text);
            baseName = m.Success ? m.Value.ToUpperInvariant() : $"pasted-{queued.Count + 1}";
        }

        baseName = SafeNameRe.Replace(baseName, "_");
        if (baseName.Length > 60) { baseName = baseName[..60]; }

        string ext = looksJson ? ".json" : ".txt";
        string name = baseName.EndsWith(ext, StringComparison.OrdinalIgnoreCase)
            ? baseName
            : baseName + ext;

        int suffix = 1;
        string candidate = name;
        while (queued.Any(q => q.Name == candidate))
        {
            candidate = $"{baseName}-{++suffix}{ext}";
        }

        queued.Add(new QueuedFile(candidate, Encoding.UTF8.GetBytes(pasteText), true));
        pasteText = string.Empty;
        pasteName = string.Empty;
        errorMessage = null;
    }

    private void RemoveFile(QueuedFile file) => queued.Remove(file);

    // ====================================================================
    // extraction run
    // ====================================================================

    private Task ExtractAsync()
    {
        isBusy = true;
        errorMessage = null;
        copiedKey = null;
        combineKeys.Clear();
        combinedSearches.Clear();

        try
        {
            if (queued.Count == 0)
            {
                errorMessage = "Add a file or paste some content first.";
                return Task.CompletedTask;
            }

            var store = new IocStore();
            var runReports = new List<ReportInfo>();
            var runErrors = new List<string>();

            searchBook = LoadSearchBook(_env.ContentRootPath);
            if (searchBook.Problem is not null) { runErrors.Add(searchBook.Problem); }
            if (searchBook.UnknownKeys.Count > 0)
            {
                runErrors.Add(SearchFileName + " names categories that do not exist: "
                    + string.Join(", ", searchBook.UnknownKeys) + ". Those entries were ignored.");
            }

            foreach (QueuedFile file in queued)
            {
                try
                {
                    runReports.Add(ParseOne(file, store));
                }
                catch (RegexMatchTimeoutException)
                {
                    runErrors.Add($"{file.Name}: pattern matching timed out, skipped.");
                }
                catch (Exception ex)
                {
                    runErrors.Add($"{file.Name}: {ex.Message}");
                }
            }

            resolvedScope = ResolveScope(splunkScope, searchBook.DefaultScope);
            categories = BuildCategories(store, resolvedScope, searchBook);
            reports = runReports;
            errors = runErrors;
            totalItems = categories.Sum(c => c.Items.Count);
            flaggedCount = categories.Sum(c => c.Items.Count(i => i.Flagged));
            activeGroup = "all";
            hasExtracted = true;

            if (store.Truncated)
            {
                errors.Add($"At least one category hit the {MaxItemsPerCategory:N0} item " +
                           "ceiling and was cut short.");
            }
        }
        catch (Exception)
        {
            //Log.Error(ex, "Uh oh! IOCExcavator.razor -> ExtractAsync() has caught an exception!");
            errorMessage = "Those files could not be parsed. STIX 2.x JSON or plain " +
                           "text IOC lists work best.";
        }
        finally
        {
            isBusy = false;
        }

        return Task.CompletedTask;
    }

    /// <summary>Parses one queued file as STIX when it is JSON, as text otherwise.</summary>
    private static ReportInfo ParseOne(QueuedFile file, IocStore store)
    {
        string text = Decode(file.Bytes);
        string trimmed = text.TrimStart();

        if (trimmed.Length > 0 && trimmed[0] is '{' or '[')
        {
            try
            {
                using JsonDocument doc = JsonDocument.Parse(text, JsonOptions);
                return ParseStix(doc.RootElement, file.Name, store);
            }
            catch (System.Text.Json.JsonException)
            {
                // malformed JSON is still worth sweeping; say so in the report row
            }
        }

        Match m = AdvisoryIdRe.Match(file.Name);
        string source = m.Success
            ? m.Value.ToUpperInvariant()
            : Clip(file.Name.Split('.')[0], 40);

        TextSweep(store, text, source, deep: true);

        return new ReportInfo
        {
            Source = source,
            Title = file.Name,
            Published = string.Empty,
            File = file.Name,
            Indicators = 0,
            Objects = 0,
            Note = "swept as plain text",
        };
    }

    private static string Decode(byte[] data)
    {
        try
        {
            return new UTF8Encoding(false, throwOnInvalidBytes: true)
                .GetString(data).TrimStart('\uFEFF');
        }
        catch (DecoderFallbackException)
        {
            return Encoding.Latin1.GetString(data);
        }
    }

    private static string Clip(string s, int max) => s.Length <= max ? s : s[..max];

