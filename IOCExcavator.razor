    private static string NormName(string? name) =>
        NonAlnumRe.Replace((name ?? string.Empty).ToLowerInvariant(), string.Empty);

    private static ToolInfo? LookupTool(string? name)
    {
        string key = NormName(name);
        if (key.Length == 0) { return null; }
        if (Tools.TryGetValue(key, out ToolInfo? exact)) { return exact; }

        foreach ((string k, ToolInfo v) in Tools)
        {
            if (k.Length >= 5 && key.Contains(k, StringComparison.Ordinal)) { return v; }
        }

        return null;
    }

