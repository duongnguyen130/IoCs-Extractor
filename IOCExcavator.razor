    /// <summary>De-duplicating collector. Insertion order is kept, because that is the order the advisory used.</summary>
    private sealed class IocStore
    {
        private readonly Dictionary<string, List<IocItem>> order = new();
        private readonly Dictionary<string, Dictionary<string, IocItem>> index = new();

        public bool Truncated { get; private set; }

        public IocStore()
        {
            foreach ((string key, _, _) in Categories)
            {
                order[key] = new List<IocItem>();
                index[key] = new Dictionary<string, IocItem>(StringComparer.OrdinalIgnoreCase);
            }
        }

        public List<IocItem> Items(string category) => order[category];

        public bool Has(string category, string value) =>
            index[category].ContainsKey(value.Trim());

        public IocItem? Add(string category, string? value, string source,
                            string? context = null, IEnumerable<string>? related = null)
        {
            if (value is null) { return null; }

            string v = value.Trim();
            if (v.Length == 0 || v.Length > 4096) { return null; }

            if (LowercaseCategories.Contains(category)) { v = v.ToLowerInvariant(); }

            Dictionary<string, IocItem> bucket = index[category];

            if (!bucket.TryGetValue(v, out IocItem? item))
            {
                if (order[category].Count >= MaxItemsPerCategory)
                {
                    Truncated = true;
                    return null;
                }

                item = new IocItem { Value = v };
                bucket[v] = item;
                order[category].Add(item);
            }

            if (!string.IsNullOrEmpty(source) && !item.Sources.Contains(source))
            {
                item.Sources.Add(source);
            }

            if (!string.IsNullOrEmpty(context) && !item.Context.Contains(context))
            {
                item.Context.Add(context);
            }

            foreach (string r in related ?? Enumerable.Empty<string>())
            {
                if (!string.IsNullOrWhiteSpace(r)
                    && !string.Equals(r, v, StringComparison.OrdinalIgnoreCase)
                    && !item.Related.Contains(r))
                {
                    item.Related.Add(r);
                }
            }

            return item;
        }
    }

